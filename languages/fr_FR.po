#: inc/admin.php:64
msgid "<strong>Book WP:</strong> %1$d chapter post is missing the <code>chapter_number</code> custom field. Without it, chapters fall back to date ordering. <a href=\"%2$s\">Edit posts</a>"
msgid_plural "<strong>Book WP:</strong> %1$d chapter posts are missing the <code>chapter_number</code> custom field. Without it, chapters fall back to date ordering. <a href=\"%2$s\">Edit posts</a>"
msgstr[0] "<strong>Book WP :</strong> %1$d article chapitre n'a pas le champ personnalisé <code>chapter_number</code>. Sans lui, les chapitres sont classés par date. <a href=\"%2$s\">Modifier les articles</a>"
msgstr[1] "<strong>Book WP :</strong> %1$d articles chapitres n'ont pas le champ personnalisé <code>chapter_number</code>. Sans lui, les chapitres sont classés par date. <a href=\"%2$s\">Modifier les articles</a>"

